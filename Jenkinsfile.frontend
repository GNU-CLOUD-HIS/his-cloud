// =====================================================================
// 프론트(hisfrontend-nginx): 소스 받기 → 이미지 빌드(Dockerfile 안에서 npm ci + next build) → push → 배포
// job 이름: his-frontend
// 미리 있어야 하는 것: Credentials dockerhub, 이 저장소의 k8s/frontend.yaml (image 자리에 __IMAGE__)
// =====================================================================
pipeline {
    agent { label 'remote-linux-node' }

    options {
        disableConcurrentBuilds()
        timeout(time: 40, unit: 'MINUTES')              // npm ci + next build 는 백엔드보다 오래 걸린다
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    triggers {
        pollSCM('H/5 * * * *')
    }

    environment {
        DOCKERHUB_ID = 'jinki238'
        NS           = 'his'
        FRONT_REPO   = 'https://github.com/SEOUL-IT-HIS/hisfrontend.git'
        FRONT_BRANCH = 'nginx'          // [확인 필요] 지금 18090 의 v2.4-nginx 를 만든 브랜치. 팀 통합 후에는 develop
    }

    stages {
        stage('준비') {
            steps {
                script {
                    env.IMAGE = "${env.DOCKERHUB_ID}/hisfrontend:b${env.BUILD_NUMBER}"
                }
                sh '''
                    export PATH="$HOME/bin:$PATH"
                    which kubectl docker
                    kubectl -n "$NS" get ns "$NS" >/dev/null
                '''
            }
        }

        stage('소스 받기') {
            steps {
                dir('src') {
                    git url: env.FRONT_REPO, branch: env.FRONT_BRANCH
                }
            }
        }

        stage('이미지 빌드·push') {
            steps {
                dir('src') {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub',
                                                      usernameVariable: 'DH_USER',
                                                      passwordVariable: 'DH_TOKEN')]) {
                        sh '''
                            export DOCKER_CONFIG="$WORKSPACE/.docker"
                            mkdir -p "$DOCKER_CONFIG"
                            echo "$DH_TOKEN" | docker login -u "$DH_USER" --password-stdin
                            docker build -t "$IMAGE" .
                            docker push "$IMAGE"
                        '''
                    }
                }
            }
        }

        stage('배포') {
            steps {
                sh '''
                    export PATH="$HOME/bin:$PATH"
                    sed "s|__IMAGE__|$IMAGE|g" k8s/frontend.yaml | kubectl apply -f -
                    kubectl -n "$NS" rollout status deployment/hisfrontend-nginx --timeout=300s
                    kubectl -n "$NS" get pods -l app=hisfrontend-nginx -o wide
                '''
            }
        }
    }

    post {
        always {
            sh '''
                export DOCKER_CONFIG="$WORKSPACE/.docker"
                docker logout >/dev/null 2>&1 || true
                rm -rf "$DOCKER_CONFIG"
                if [ -n "$IMAGE" ]; then docker rmi "$IMAGE" >/dev/null 2>&1 || true; fi
            '''
        }
    }
}
