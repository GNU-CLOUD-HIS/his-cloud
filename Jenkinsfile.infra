// =====================================================================
// 인프라: namespace 확인 → 공통 ConfigMap + Redis + Kafka + SeaweedFS(PVC 포함) 적용 → 기동 확인
// job 이름: his-infra
// 빌드할 이미지가 없다(공식 이미지를 그대로 쓴다). 그래서 "CD 만" 있는 job 이다.
//
// 이 job 은 절대 delete 하지 않는다. apply 만 한다.
// (common.yaml 에 SeaweedFS 의 PVC 가 들어 있어서 delete 하면 저장된 파일이 사라진다)
// =====================================================================
pipeline {
    agent { label 'remote-linux-node' }

    options {
        disableConcurrentBuilds()
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        NS = 'his'
    }

    stages {
        stage('사전 확인') {
            steps {
                sh '''
                    export PATH="$HOME/bin:$PATH"
                    kubectl get ns "$NS" >/dev/null 2>&1 || kubectl create namespace "$NS"
                    # 비밀번호는 파이프라인이 만들지 않는다. 서버에서 한 번만 read -rsp 로 만든다(가이드 2-4)
                    kubectl -n "$NS" get secret redis-secret >/dev/null || { echo "redis-secret 이 없다"; exit 1; }
                '''
            }
        }

        stage('적용') {
            steps {
                sh '''
                    export PATH="$HOME/bin:$PATH"
                    kubectl apply -f k8s/common.yaml
                '''
            }
        }

        stage('기동 확인') {
            steps {
                sh '''
                    export PATH="$HOME/bin:$PATH"
                    for d in redis kafka seaweedfs; do
                        kubectl -n "$NS" rollout status "deployment/$d" --timeout=240s
                    done
                    kubectl -n "$NS" get deploy,svc,pvc
                '''
            }
        }
    }
}
