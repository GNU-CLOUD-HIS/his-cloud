// =====================================================================
// 전체 재구축: 인프라 → admin → 나머지 9개 서비스 → 프론트 → nginx 를 순서대로 실행한다
// job 이름: his-all
// 각 단계는 다른 job 을 부르기만 한다. 실제 일은 his-infra, his-svc-*, his-frontend, his-nginx 가 한다.
// 하나라도 실패하면 거기서 멈춘다(뒤 단계는 실행하지 않는다).
// =====================================================================
pipeline {
    agent none                     // 다른 job 을 부르기만 하므로 실행 노드가 필요 없다

    options {
        disableConcurrentBuilds()
        timeout(time: 4, unit: 'HOURS')
    }

    parameters {
        booleanParam(name: 'RUN_INFRA', defaultValue: true, description: '인프라(Redis·Kafka·SeaweedFS)도 적용한다')
        booleanParam(name: 'RUN_FRONT', defaultValue: true, description: '프론트와 nginx 도 배포한다')
    }

    stages {
        stage('인프라') {
            when { expression { params.RUN_INFRA } }
            steps { build job: 'his-infra' }
        }

        stage('admin') {
            // 다른 서비스의 initContainer 가 admin:9191 을 기다리므로 admin 이 먼저
            steps { build job: 'his-svc-admin' }
        }

        stage('나머지 서비스') {
            steps {
                script {
                    // 공용 서버 메모리·CPU 를 생각해서 동시에가 아니라 하나씩
                    for (s in ['patient', 'reception', 'outpatient', 'emergency', 'inpatient',
                               'labimaging', 'surgery', 'pharmacy', 'billing']) {
                        build job: "his-svc-${s}"
                    }
                }
            }
        }

        stage('프론트') {
            when { expression { params.RUN_FRONT } }
            steps { build job: 'his-frontend' }
        }

        stage('nginx') {
            when { expression { params.RUN_FRONT } }
            steps { build job: 'his-nginx' }
        }
    }
}
