// =====================================================================
// 백엔드 서비스 1개: 소스 받기 → jar 빌드 → 이미지 빌드·push → 쿠버네티스 배포
//
// 이 파일 하나를 10개 job 이 같이 쓴다. job 이름을 "his-svc-<서비스명>" 으로 만들면
// 이름에서 서비스를 알아낸다.  예) his-svc-labimaging, his-svc-admin
//
// 미리 있어야 하는 것
//   - Jenkins Credentials: dockerhub (Username with password, 비밀번호 칸 = Docker Hub 액세스 토큰)
//   - 서버: namespace his, his-common-config(인프라 job 이 만듦), <서비스>-secret, redis-secret
//   - 이 저장소: k8s/services/<서비스명>.yaml  (image 자리에 __IMAGE__)
// =====================================================================

// [확인 필요] TODO 로 된 저장소 이름은 팀 GitHub(SEOUL-IT-HIS)에서 확인해 채운다.
// branch 는 18090 에 올릴 소스의 브랜치. 팀 규칙상 통합 브랜치는 develop.
def SERVICES = [
    admin      : [repo: 'TODO-admin-repo',      branch: 'develop'],
    billing    : [repo: 'TODO-billing-repo',    branch: 'develop'],
    pharmacy   : [repo: 'pharmacyservice',      branch: 'develop'],
    reception  : [repo: 'TODO-reception-repo',  branch: 'develop'],
    surgery    : [repo: 'TODO-surgery-repo',    branch: 'develop'],
    labimaging : [repo: 'lab-imaging-service',  branch: 'develop'],
    inpatient  : [repo: 'TODO-inpatient-repo',  branch: 'develop'],
    patient    : [repo: 'TODO-patient-repo',    branch: 'develop'],
    outpatient : [repo: 'TODO-outpatient-repo', branch: 'develop'],
    emergency  : [repo: 'TODO-emergency-repo',  branch: 'develop'],
]

pipeline {
    agent { label 'remote-linux-node' }

    options {
        disableConcurrentBuilds()                       // 같은 서비스가 동시에 두 번 배포되지 않게
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))  // 빌드 기록은 10개만
    }

    triggers {
        pollSCM('H/5 * * * *')   // 5분마다 저장소 변경 확인. (Jenkins 가 내 PC 라 GitHub 웹훅은 닿지 않는다)
    }

    environment {
        DOCKERHUB_ID = 'jinki238'
        NS           = 'his'
    }

    stages {
        stage('준비') {
            steps {
                script {
                    env.SVC = env.JOB_BASE_NAME.replaceFirst(/^his-svc-/, '')
                    def s = SERVICES[env.SVC]
                    if (s == null) {
                        error "job 이름에서 서비스를 찾지 못했다: ${env.JOB_BASE_NAME} (his-svc-<서비스명> 이어야 함)"
                    }
                    if (s.repo.startsWith('TODO')) {
                        error "${env.SVC} 의 저장소 이름이 아직 TODO 다. Jenkinsfile.backend 의 SERVICES 를 채운다."
                    }
                    env.REPO_URL   = "https://github.com/SEOUL-IT-HIS/${s.repo}.git"
                    env.SRC_BRANCH = s.branch
                    env.IMAGE      = "${env.DOCKERHUB_ID}/his-${env.SVC}:b${env.BUILD_NUMBER}"
                    currentBuild.displayName = "#${env.BUILD_NUMBER} ${env.SVC}"
                }
                // kubectl 은 ~/bin 에 있다. Jenkins 가 실행하는 셸은 ~/bin 을 PATH 에 안 넣을 수 있어서 sh 마다 앞에 붙인다
                sh '''
                    export PATH="$HOME/bin:$PATH"
                    which kubectl docker java
                    test -f "k8s/services/$SVC.yaml" || { echo "k8s/services/$SVC.yaml 이 없다"; exit 1; }
                    kubectl -n "$NS" get secret "$SVC-secret" >/dev/null || { echo "$SVC-secret 이 없다 (수동으로 한 번 만든다)"; exit 1; }
                '''
            }
        }

        stage('소스 받기') {
            steps {
                dir('src') {
                    git url: env.REPO_URL, branch: env.SRC_BRANCH
                }
            }
        }

        stage('jar 빌드') {
            steps {
                dir('src') {
                    // --no-daemon: 공용 서버에 Gradle 데몬이 남아 메모리를 잡지 않게
                    sh 'chmod +x gradlew && ./gradlew clean bootJar -x test --no-daemon'
                }
            }
        }

        stage('이미지 빌드·push') {
            steps {
                dir('src') {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub',
                                                      usernameVariable: 'DH_USER',
                                                      passwordVariable: 'DH_TOKEN')]) {
                        // 작은따옴표 ''' : 토큰이 Groovy 문자열에 섞이지 않고 셸 변수로만 쓰인다
                        // DOCKER_CONFIG: guest4 는 공용 계정이라 로그인 정보를 ~/.docker 가 아니라 이 빌드 폴더에만 둔다
                        sh '''
                            export DOCKER_CONFIG="$WORKSPACE/.docker"
                            mkdir -p "$DOCKER_CONFIG"
                            echo "$DH_TOKEN" | docker login -u "$DH_USER" --password-stdin
                            docker build -t "$IMAGE" .
                            docker push "$IMAGE"
                        '''
                    }
                }
            }
        }

        stage('배포') {
            steps {
                sh '''
                    export PATH="$HOME/bin:$PATH"
                    sed "s|__IMAGE__|$IMAGE|g" "k8s/services/$SVC.yaml" | kubectl apply -f -
                    # startupProbe 최대 5분 + admin 대기(initContainer)가 있으므로 넉넉하게
                    kubectl -n "$NS" rollout status "deployment/$SVC" --timeout=420s
                    kubectl -n "$NS" get pods -l "app=$SVC" -o wide
                '''
            }
        }
    }

    post {
        always {
            sh '''
                export DOCKER_CONFIG="$WORKSPACE/.docker"
                docker logout >/dev/null 2>&1 || true
                rm -rf "$DOCKER_CONFIG"
                # 서버 Docker 에 남은 내 이미지만 지운다 (Docker Hub 에는 남아 있으므로 되돌리기 가능)
                if [ -n "$IMAGE" ]; then docker rmi "$IMAGE" >/dev/null 2>&1 || true; fi
            '''
        }
        failure {
            echo "실패. 배포 단계에서 실패했다면 이전 Pod 가 계속 서비스 중이다(maxUnavailable 0). 원인: kubectl -n his describe pod -l app=${env.SVC}"
        }
    }
}
